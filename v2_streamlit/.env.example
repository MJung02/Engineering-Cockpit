# Engineering Cockpit - Konfigurationsvorlage
# Kopieren nach .env und anpassen: cp .env.example .env

# ── PostgreSQL (Pflicht seit Phase A) ──────────────────
# Lokal per Docker Compose: docker compose up -d
EC_PG_HOST=localhost
EC_PG_PORT=5432
EC_PG_DATABASE=engineering_cockpit
EC_PG_USER=cockpit
EC_PG_PASSWORD=cockpit_dev_pw

# ── KI-Backend (optional) ──────────────────────────────
# KI_BACKEND: auto (Anthropic > Ollama > lokales Modell) | anthropic | ollama | lokal
KI_BACKEND=auto
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b-instruct empfohlen (~4.7GB, braucht min. 8GB RAM) - deutlich
# zuverlaessiger bei strukturierten Ausgaben als kleinere Modelle wie phi3.
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── Lokales, eingebettetes Modell (Phase J) ────────────
# Laeuft direkt im Python-Prozess (llama-cpp-python) - kein Hintergrunddienst,
# kein API-Key, komplett offline. GGUF-Datei manuell besorgen (z.B. von
# huggingface.co, Suche "Phi-3.5-mini-instruct GGUF" oder "Llama-3.2-3B-Instruct
# GGUF", Q4_K_M-Quantisierung empfohlen, ca. 2-2.5GB) und Pfad hier eintragen.
LOKAL_MODELL_PFAD=models/lokales-modell.gguf
LOKAL_MODELL_CTX=4096
LOKAL_MODELL_THREADS=4

# ── SSO ueber Microsoft Entra ID (Phase J, optional) ────
# Leer lassen = bestehender E-Mail/Passwort-Login bleibt aktiv. Werte kommen
# aus einer Azure-AD-App-Registration, die nur die IT/ein Azure-AD-Admin
# anlegen kann (Anleitung: App -> Einstellungen -> SSO (Azure AD)).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8501
